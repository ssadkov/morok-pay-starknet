# Optional. Used for Base / Base Sepolia USDC reads and CCTP burns.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Default network before the in-app Mainnet / Sepolia switcher is used.
# Sepolia is the dry-run default. Set mainnet to start on production.
NEXT_PUBLIC_STARKNET_NETWORK=sepolia
NEXT_PUBLIC_STARKNET_RPC_URL=https://rpc.starknet.lava.build
NEXT_PUBLIC_STARKNET_SEPOLIA_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia

# The Sepolia fallback is the current MorokPay test treasury. Mainnet stays
# disabled until a production treasury is explicitly configured.
NEXT_PUBLIC_MOROK_TREASURY_SEPOLIA_ADDRESS=0x00E5887fC74A11d10Ad5dd2f69D3911Fb352d9b811528a9281Ca8aBAc8498423
NEXT_PUBLIC_MOROK_TREASURY_MAINNET_ADDRESS=

# Server-only Sepolia signer used only for the EIP-712 AccountFactory deployment.
# Keep the private key in local/Vercel secrets; never prefix it with NEXT_PUBLIC_.
MOROKPAY_SEPOLIA_RPC_URL=https://api.zan.top/public/starknet-sepolia
MOROKPAY_SEPOLIA_RELAYER_ADDRESS=
MOROKPAY_SEPOLIA_RELAYER_PRIVATE_KEY=
# Sepolia-only promotion: atomically top up the generated account to this
# balance and deploy it. The same server-only relayer signs both calls.
MOROKPAY_SEPOLIA_SPONSORED_STRK=20
# Retained only by the optional public-faucet diagnostic route.
MOROKPAY_SEPOLIA_MIN_DEPLOY_STRK=5

# Server-only mainnet signer for the same AccountFactory deployment call.
# It never transfers STRK to the connecting account - mainnet is self-funded
# only for now, so this key only needs enough STRK to pay its own gas for
# repeated deploy_account calls, not a sponsorship float.
MOROKPAY_MAINNET_RPC_URL=https://rpc.starknet.lava.build
MOROKPAY_MAINNET_RELAYER_ADDRESS=
MOROKPAY_MAINNET_RELAYER_PRIVATE_KEY=
# Deploy is refused unless the generated address already holds this much
# public STRK - covers the mainnet pool fee plus gas for registration.
MOROKPAY_MAINNET_MIN_DEPLOY_STRK=15

# Basis points MorokPay takes on a USDC -> STRK swap, paid out by AVNU to
# the treasury address above. Capped at 100 in code. Unset or 0 charges nothing.
MOROKPAY_AVNU_INTEGRATOR_FEE_BPS=
