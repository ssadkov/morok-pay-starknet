# Optional. Used for Base / Base Sepolia USDC reads and CCTP burns.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Default network before the in-app Mainnet / Sepolia switcher is used.
# Sepolia is the dry-run default. Set mainnet to start on production.
NEXT_PUBLIC_STARKNET_NETWORK=sepolia
NEXT_PUBLIC_STARKNET_RPC_URL=https://rpc.starknet.lava.build
NEXT_PUBLIC_STARKNET_SEPOLIA_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia

# Optional. Enables the one-click Ready deployment button. The UI clearly
# discloses that activation sends 0.01 public STRK to this MorokPay treasury.
NEXT_PUBLIC_MOROK_TREASURY_ADDRESS=
